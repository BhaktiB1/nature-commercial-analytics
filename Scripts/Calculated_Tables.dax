04. Risk measures =
Row("Column", BLANK())

// Table: 05. Dynamic measures
05. Dynamic measures =
Row("Column", BLANK())

// Table: 06. Executive Insights
06. Executive Insights =
Row("Column", BLANK())

// Table: Calendar
Calendar =
ADDCOLUMNS(
    CALENDAR(
        DATE(2023, 1, 1),
        DATE(2026, 12, 31)
    ),
    "Year", YEAR([Date]),
    "Month Number", MONTH([Date]),
    "Month Name", FORMAT([Date], "MMMM"),
    "Month Short", FORMAT([Date], "MMM"),
    "Year Month", FORMAT([Date], "YYYY-MM"),
    "Quarter", "Q" & QUARTER([Date]),
    "Year Quarter",
        YEAR([Date]) & "-Q" & QUARTER([Date]),
    "Month Start",
        DATE(YEAR([Date]), MONTH([Date]), 1)
)

// Table: Contract Risk Categories
Contract Risk Categories =
DATATABLE(
    "Risk", STRING,
    "Sort", INTEGER,
    {
        {"Low", 1},
        {"Medium", 2},
        {"High", 3},
        {"Insufficient Data", 4}
    }
)

